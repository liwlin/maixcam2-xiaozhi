[Unit]
Description=XiaoZhi AI voice assistant service (wake word + xiaozhi cloud)
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
Type=simple
WorkingDirectory=/root/xiaozhi
ExecStart=/usr/bin/python3 -u /root/xiaozhi/xiaozhi_service.py
Restart=always
RestartSec=5
Environment=PYTHONUNBUFFERED=1
Environment=LD_LIBRARY_PATH=/usr/local/lib:/usr/lib:/opt/lib:/opt/usr/lib:/soc/lib
Environment=SSL_CERT_FILE=/etc/ssl/certs/ca-certificates.crt

[Install]
WantedBy=multi-user.target
