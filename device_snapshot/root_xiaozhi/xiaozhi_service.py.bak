    "client_id": "",
    "serial_number": "",
    "hmac_key": "",
    "activated": False,
    "volume": 80,
}

# 弹窗几何（对齐素材图：左侧大面板，覆盖主页左半区）
W, H = 372, 410
POPUP_X, POPUP_Y = 12, 56

