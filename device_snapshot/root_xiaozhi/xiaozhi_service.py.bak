SAMPLE_RATE = 16000
FRAME_MS = 20                                   # py-xiaozhi: FRAME_DURATION=20
CHUNK = SAMPLE_RATE * FRAME_MS // 1000          # 320 samples = 640 bytes
OPUS_FRAME = CHUNK
CHUNK_BYTES = CHUNK * 2                         # 640 字节（int16 单声道定长块）

